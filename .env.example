APP_ENV=local

POSTGRES_DB=commerceflow
POSTGRES_USER=commerceflow
POSTGRES_PASSWORD=commerceflow_local_password
DATABASE_URL=postgresql+psycopg://commerceflow:commerceflow_local_password@127.0.0.1:5432/commerceflow

API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Phase 3B keeps real LLM access disabled by default.
LLM_PROVIDER=disabled
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

# OpenTelemetry is optional. Raw messages, prompts, keys and connection strings are never exported.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=commerceflow-api
TRACE_UI_URL=http://localhost:16686

# Policy embeddings remain deterministic by default for reproducible local evaluation.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSIONS=1536
